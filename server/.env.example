# ANIMA-S3 server environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git (R10).
# All variables without defaults are REQUIRED before the server will start.

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------
# Address to bind the WebSocket server
ANIMA_HOST=0.0.0.0
ANIMA_PORT=8765

# ---------------------------------------------------------------------------
# Authentication
# Provide a JSON object mapping device_id -> bearer_token.
# Example: {"device_aabbcc": "super-secret-token-1"}
# Alternatively, set ANIMA_DEVICE_TOKENS_FILE to a path to a YAML/JSON file.
# ---------------------------------------------------------------------------
ANIMA_DEVICE_TOKENS=
ANIMA_DEVICE_TOKENS_FILE=

# ---------------------------------------------------------------------------
# Admin API (separate port, separate token)
# ---------------------------------------------------------------------------
ANIMA_ADMIN_HOST=127.0.0.1
ANIMA_ADMIN_PORT=8766
ANIMA_ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# LLM provider
# llm_provider: "groq" | "ollama" | "openai"
# ---------------------------------------------------------------------------
LLM_PROVIDER=groq
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=

# ---------------------------------------------------------------------------
# STT (faster-whisper)
# ---------------------------------------------------------------------------
WHISPER_MODEL=base.en
WHISPER_COMPUTE=int8
WHISPER_DEVICE=cpu

# ---------------------------------------------------------------------------
# TTS (kokoro-onnx)
# ---------------------------------------------------------------------------
KOKORO_MODEL=
KOKORO_VOICES=
KOKORO_VOICE=af_bella
KOKORO_SPEED=1.05

# ---------------------------------------------------------------------------
# Audio / pipeline tuning
# These default to the values in protocol/constants.yaml.
# Only set them here if you need to override the defaults.
# ---------------------------------------------------------------------------
# ANIMA_PACER_LEAD_MS=1000
# ANIMA_LISTEN_TIMEOUT_MS=6000
# ANIMA_MAX_TURN_MS=20000
# ANIMA_FIXED_SILENCE_MS=700
# ANIMA_TOOL_TIMEOUT_MS=2000

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
